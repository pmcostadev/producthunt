# ---------- OAuth mode (lets other people connect their own PH account) ----------
# From https://www.producthunt.com/v2/oauth/applications
# Set the app's Redirect URI to: https://<your-domain>/api/oauth/callback
PH_CLIENT_ID=
PH_CLIENT_SECRET=

# Any random string, 32+ characters. Encrypts the tokens this server issues.
# Generate one with: openssl rand -base64 32
OAUTH_SIGNING_SECRET=

# Optional. Scopes requested from Product Hunt. "write" also needs their approval.
PH_SCOPES=public private

# Optional. Pin the public origin if the deployment sits behind a proxy.
OAUTH_PUBLIC_ORIGIN=

# ---------- API-key mode (single user, no OAuth) ----------
# Optional fallback: if set, requests without a token use this developer token.
PRODUCTHUNT_TOKEN=
